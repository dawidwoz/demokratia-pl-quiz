# Angular SPA fallback for LiteSpeed/Apache (vh.pl reads .htaccess).
# UNVERIFIED: the cPanel Node.js App may add its own rules for the API path and may conflict
# with this block. Keep /api/ out of the fallback; confirm the real behaviour on the host.
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]
